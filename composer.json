{
  "name": "volleyballvault/affibloom-lasso-migrator",
  "description": "Moves a site from Lasso to Affibloom: its links, settings and content.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.10",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.1",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": {
    "psr-4": { "AffibloomLassoMigrator\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": {
      "AffibloomLassoMigrator\\Tests\\": "tests/",
      "Affibloom\\": "../affibloom/src/"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyse": "phpstan analyse --memory-limit=1G",
    "test:unit": "phpunit -c phpunit.xml.dist"
  },
  "config": {
    "platform": { "php": "8.3.0" },
    "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true },
    "sort-packages": true
  }
}
